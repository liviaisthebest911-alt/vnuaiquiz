# Sao chép thành backend/.env (không commit). Chỉ backend đọc các biến này.
GEMINI_API_KEY=
# Supabase pooler. Đã kiểm tra: Session pooler (cổng 5432). Transaction pooler (6543) CHƯA kiểm tra.
# Mật khẩu phải URL-encode. KHÔNG thêm ?sslmode=...
DATABASE_URL=
# CA của Supabase (PEM, Dashboard → Database → SSL Configuration). Bắt buộc với DB từ xa: TLS luôn kiểm tra chứng chỉ.
# Một dòng: thay xuống dòng bằng \n.
DATABASE_CA_CERT=
# URL project Supabase (https://<ref>.supabase.co) – để xác minh access token qua JWKS (khoá ký bất đối xứng).
SUPABASE_URL=
# Secret key (sb_secret_..., hoặc service_role cũ) – CHỈ backend: ký URL upload/xem/tải và đọc/xoá object Storage.
SUPABASE_SECRET_KEY=
# Domain frontend được gọi API, cách nhau dấu phẩy. Bỏ trống = http://localhost:5173
CORS_ORIGINS=
PORT=5000
