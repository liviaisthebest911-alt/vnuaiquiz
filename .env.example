# ==========================================================================
# .env.example — vnuaiquiz
# --------------------------------------------------------------------------
# Dự án hiện tại KHÔNG đọc bất kỳ biến môi trường nào trong code (SPA tĩnh,
# không gọi API/AI/Database). File này để trống có chủ đích — không đặt
# key giả cho những thứ chưa tồn tại trong codebase.
#
# Khi bạn thêm tính năng cần biến môi trường trong tương lai (vd: gọi API
# chấm điểm bằng AI, kết nối backend riêng...), thêm vào đây theo cú pháp:
#
#   VITE_TEN_BIEN=gia_tri
#
# Lưu ý: với Vite, MỌI biến muốn dùng được ở phía client (trong src/) BẮT
# BUỘC phải có tiền tố VITE_, và giá trị sẽ bị bundle công khai vào file JS
# (ai cũng xem được qua DevTools) — không đặt secret thật (API key, DB
# password...) vào biến VITE_*. Secret thật chỉ nên nằm ở một backend
# riêng (Vercel Serverless Function / server khác), không ở phía frontend.
# ==========================================================================
