# Sao chép thành .env.local (không commit). MỌI biến VITE_* bị bundle công khai vào JS – không đặt secret ở đây.
# Bỏ trống = app chạy như cũ (SPA tĩnh, không đăng nhập).

# Supabase Auth (Dashboard → Project Settings → API). Publishable key (sb_publishable_...) công khai theo thiết kế.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend Express, không có /api/v1 ở cuối. Vd local: http://localhost:5000; '/' = API cùng domain (bản Preview gộp)
VITE_API_URL=
